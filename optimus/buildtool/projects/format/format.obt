// all.javac.release = 11

main {
  compile {
    modules = [
      optimus.buildtool.core,
      optimus.platform.annotations // needed for @impure
    ]

    libs = [
      args4j,
      jgit,
      jib-core,
      typesafe-config,
      zstd-jni,
      jackson-module-scala,
      jsoniter-scala-core,
      jsoniter-scala-macros,
      opencsv,
//      scala,
      spray-json
    ]
  }
}

