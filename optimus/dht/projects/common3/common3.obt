all.javac.release = 11
main {
  generators {
    protobuf {
      templates = [proto]
    }
  }

  compile {
    modules = [optimus.platform.missing]
    libs = [
      commons-lang3
      io.netty.netty-handler
      //    io.netty.netty-tcnative-boringssl-static
      //    io.netty.netty-transport-native-epoll
      // msjava.msnet
      // msjava.zkapi
      guice
      guava
      hdrhistogram
      jctools
      protobuf-java
      slf4j
      // sam.zookeeper
    ]
  }

}

