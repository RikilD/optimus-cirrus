// all.javac.release = 11

main {
  hasMacros = true
  implementsMacros = true
  compile {
    modules = [
      // core_macro dependency is to enable rewrite of log.debug with a macro
      optimus.platform.core_macro,
      optimus.platform.missing
      optimus.platform.utils
    ]
    libs = [
      zookeeper,
//      // msjava.base,
//      // msjava.zkapi,
      archaius-core,
      args4j,
      curator-client,
      guava,
      httpcomponents-client,
//      httpcomponents-core,
      iharder-base64,
//      jsr305-annotations,
      logback,
//      metrics-core.variant.kafka,
      slf4j,
      snakeyaml,
//      zkclient,
      apache-kafka,
//      scala.tools,
      spray-json
    ]
  }
  runtime.libs = [
    // // msjava.logbackutils,
    // // msjava.slf4jutils
  ]

//  copyFiles = [
//    {from = "scripts", into = "etc/config/breadcrumbs/scripts"}
//  ]
}

